environment = "dev"
owner       = "platform-team"
cost_center = "media-dev"

# Landing Zone remote state (read-only)
landing_zone_state_bucket = "<landing-zone-state-bucket>"
landing_zone_state_key    = "<landing-zone-state-key>"
landing_zone_state_region = "<landing-zone-state-bucket-region>"

# Optional: serve under your domain. Must be covered by the Landing Zone us-east-1 certificate.
# cloudfront_aliases = ["media.yourdomain.com"]

enable_media_package    = false # live channel (deployed from eu-west-1)
enable_aurora           = false
enable_replication      = true
enable_dynamodb_replica = true
